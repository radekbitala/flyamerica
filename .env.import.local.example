# Vzor pro .env.import.local: proměnné pro ostrý import deníku
# (node scripts/import-denik.mjs --ostre, postup v README, Import deníku).
# Zkopírujte jako .env.import.local a doplňte hodnoty. Ten soubor se necommituje,
# po importu ho smažte. Sem žádné hodnoty nepatří.

# Adresa projektu Supabase (https://<projekt>.supabase.co)
SUPABASE_URL=

# Servisní klíč projektu Supabase, stejná hodnota jako SUPABASE_SERVICE_ROLE_KEY ve Vercelu
SUPABASE_SERVICE_ROLE_KEY=

# Připojení k databázi: session pooler (port 5432) nebo direct connection, ne transaction pooler
DATABASE_URL=
